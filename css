* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

/* hem creat variables dels colors per optimitzar el codi */
:root {
    --vermell-fosc: #780000;
    --vermell: #C1121F;
    --beix: #FDF0D5;
    --blau-fosc: #003049;
    --blau: #669BBC;
}

/* general*/
body {
    font-family: 'Arial', sans-serif;
    background-color: var(--beix);
    color: var(--blau-fosc);
    line-height: 1.6;
}

/* header */
header {
    background-color:#FDF0D5;
    padding: 20px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 2px solid var(--blau);
}

header h1 {
    color: var(--blau-fosc);
    font-size: 1.8rem;
    letter-spacing: 2px;
}

/* menu principal */
.menu {
    list-style: none;
    display: flex;
    gap: 20px;
}

.menu li {
    position: relative;
}

.menu a {
    text-decoration: none;
    color: var(--blau-fosc);
    font-weight: bold;
    padding: 8px 12px;
    transition: 0.3s;
}

.menu a:hover {
    background-color: var(--blau);
    color: #FDF0D5;
    border-radius: 5px;
}

/* submenu*/
.menu ul {
    display: none;
    position: absolute;
    background-color: #FDF0D5;
    list-style: none;
    top: 35px;
    padding: 10px;
    border-radius: 5px;
}

.menu li:hover ul {
    display: block;
}

/* hero section */
main section:first-of-type {
    text-align: center;
    padding: 60px 20px;
    background-color: #FDF0D5;
}

main section:first-of-type h1 {
    font-size: 2.5rem;
    margin: 10px 0;
}

main section:first-of-type h3 {
    color: var(--blau);
}

/* botons */
button {
    background-color: var(--vermell);
    border: none;
    padding: 12px 25px;
    margin-top: 20px;
    border-radius: 25px;
    cursor: pointer;
    transition: 0.3s;
}

button a {
    color: white;
    text-decoration: none;
    font-weight: bold;
}

button:hover {
    background-color: var(--vermell-fosc);
}

/* fondo inici */
img {
    display: block;
    margin: 0 auto;
}

/* seccions */
section {
    padding: 50px 40px;
}

section h2 {
    text-align: center;
    margin-bottom: 20px;
    font-size: 2rem;
}

/* llistes */
ul {
    max-width: 800px;
    margin: 0 auto;
}

/* taula */
table {
    width: 90%;
    margin: 30px auto;
    border-collapse: collapse;
    background-color: white;
    border-radius: 10px;
    overflow: hidden;
}

th {
    background-color: var(--blau-fosc);
    color: white;
    padding: 10px;
}

td {
    padding: 10px;
    text-align: center;
}

tr:nth-child(even) {
    background-color: #f5f5f5;
}

/* lloguer dels productes */
#taules {
    text-align: center;
}

div img {
    margin: 15px;
    border-radius: 10px;
    transition: 0.3s;
}

div img:hover {
    transform: scale(1.05);
}

/* footer */
footer {
    background-color: var(--blau-fosc);
    color: white;
    text-align: center;
    padding: 40px 20px;
}

footer img {
    margin: 10px;
}

footer a {
    color: var(--blau);
    text-decoration: none;
}

footer a:hover {
    text-decoration: underline;
}

footer hr {
    margin: 20px 0;
    border: 1px solid var(--blau);
}